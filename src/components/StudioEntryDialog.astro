---
import { categories } from "@/data/categories";
import PaperPublicationFields from "./PaperPublicationFields.astro";
import { pdfSizeLabel } from "@/data/papers";
---

<dialog
  id="entry-dialog"
  class="studio-dialog entry-dialog"
  aria-labelledby="entry-dialog-title"
>
  <form id="entry-dialog-form">
    <div class="entry-dialog-heading">
      <div>
        <p class="eyebrow">YOUR NOTEBOOK</p><h2 id="entry-dialog-title">
          新建记录
        </h2>
      </div>
      <button
        id="entry-dialog-close"
        type="button"
        class="studio-icon"
        aria-label="关闭记录窗口">×</button
      >
    </div>
    <fieldset id="entry-dialog-fields">
      <label class="studio-field"
        >记录类型<select id="entry-dialog-category"
          >{
            categories.map(category => (
              <option value={category.id}>
                {category.title} · {category.subtitle}
              </option>
            ))
          }</select
        ></label
      >
      <section
        id="entry-dialog-source-panel"
        class="entry-dialog-source"
        hidden
      >
        <label class="studio-field"
          ><span id="entry-dialog-source-label">论文网址</span><input
            id="entry-dialog-source"
            placeholder="https://arxiv.org/abs/… 或 PDF 下载地址"
          /></label
        >
        <div class="entry-dialog-source-actions">
          <button id="entry-dialog-identify" type="button" class="studio-button"
            >读取信息</button
          >
          <button
            id="entry-dialog-github"
            type="button"
            class="studio-button"
            hidden>通过 GitHub 获取</button
          >
          <label id="entry-dialog-file-label" class="studio-button"
            >上传 PDF<input
              id="entry-dialog-file"
              class="sr-only"
              type="file"
              accept="application/pdf,.pdf"
            /></label
          >
          <a
            id="entry-dialog-original"
            target="_blank"
            rel="noopener noreferrer"
            hidden>打开原文 ↗</a
          >
        </div>
        <p id="entry-dialog-import-error" role="alert" hidden></p>
        <a
          id="entry-dialog-import-progress"
          target="_blank"
          rel="noopener noreferrer"
          hidden>查看获取进度 ↗</a
        >
        <p id="entry-dialog-file-name" class="entry-dialog-hint"></p>
        <p id="entry-dialog-file-limit" class="entry-dialog-hint">
          单个 PDF 最大 {pdfSizeLabel}。
        </p>
        <div id="entry-dialog-results" class="entry-dialog-results"></div>
        <p
          id="entry-dialog-import-status"
          class="entry-dialog-hint"
          role="status"
        >
        </p>
      </section>
      <label class="studio-field"
        >标题<input
          id="entry-dialog-name"
          required
          maxlength="500"
          placeholder="自动读取后可修改，也可以手动填写"
        /></label
      >
      <label class="studio-field"
        >简介<textarea
          id="entry-dialog-description"
          rows="3"
          maxlength="500"
          placeholder="这篇记录讲什么…"></textarea></label
      >
      <label class="studio-field"
        >标签<input id="entry-dialog-tags" placeholder="用逗号分隔" /></label
      >
      <section id="entry-dialog-paper-info" hidden>
        <div class="entry-dialog-grid">
          <label class="studio-field"
            >作者<input id="entry-dialog-authors" maxlength="1000" /></label
          >
          <label class="studio-field"
            >年份<input
              id="entry-dialog-year"
              inputmode="numeric"
              pattern="(19|20)[0-9]{2}|"
            /></label
          >
        </div>
        <label class="studio-field"
          >DOI<input id="entry-dialog-doi" maxlength="300" /></label
        >
        <PaperPublicationFields prefix="entry-dialog" />
        <label class="studio-field"
          >论文摘要<textarea
            id="entry-dialog-abstract"
            rows="4"
            maxlength="2000"></textarea></label
        >
      </section>
      <details class="entry-dialog-options">
        <summary>更多选项</summary>
        <label class="studio-field"
          >文件名<input
            id="entry-dialog-slug"
            placeholder="根据标题自动生成"
          /><small>同步后保持文件名不变。</small></label
        >
        <label class="studio-field"
          >发布时间<input
            id="entry-dialog-date"
            type="datetime-local"
            required
          /></label
        >
        <label class="studio-checkbox"
          ><input id="entry-dialog-featured" type="checkbox" /> 设为精选记录</label
        >
        <label class="studio-checkbox"
          ><input id="entry-dialog-showcase" type="checkbox" /> 在分类展柜中展示</label
        >
      </details>
    </fieldset>
    <p id="entry-dialog-error" role="alert" hidden></p>
    <div class="dialog-actions">
      <span id="entry-dialog-save-hint" class="entry-dialog-hint"
        >先保存在本机，发布后更新网站。</span
      >
      <button id="entry-dialog-cancel" type="button" class="studio-button"
        >取消</button
      >
      <button
        id="entry-dialog-save"
        type="submit"
        class="studio-button studio-primary">创建记录</button
      >
    </div>
  </form>
</dialog>
