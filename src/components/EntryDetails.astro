---
import type { EntryMeta } from "@/data/entries";
import { entryStatuses } from "@/data/entries";
import type { CategoryId } from "@/data/categories";
import "@/styles/collections.css";
import PdfReader from "@/components/PdfReader.astro";
import { publicationText } from "@/data/papers";
interface Props {
  entry: EntryMeta;
  category: CategoryId;
}
const { entry, category } = Astro.props;
const subject =
  ["anime", "game"].includes(category) &&
  entry.subject?.type === (category === "anime" ? 2 : 4)
    ? entry.subject
    : null;
const paperSource = entry.paper.pdfUrl || entry.paper.sourceUrl;
---

{
  subject && (
    <section class="entry-detail subject-detail" aria-label="作品信息">
      <div class="entry-subject">
        {subject.image && (
          <a
            href={`https://bgm.tv/subject/${subject.id}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              src={subject.image}
              alt={subject.name}
              referrerpolicy="no-referrer"
            />
          </a>
        )}
        <div class="entry-subject-info">
          <a
            class="entry-subject-title"
            href={`https://bgm.tv/subject/${subject.id}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {subject.name} ↗
          </a>
          {subject.originalName !== subject.name && (
            <p class="entry-original-name">{subject.originalName}</p>
          )}
          <p>
            {[
              subject.date,
              subject.platform,
              subject.episodes ? `${subject.episodes} 话` : "",
            ]
              .filter(Boolean)
              .join(" · ")}
          </p>
          {subject.facts.map(fact => (
            <p class="entry-fact">
              <span>{fact.label}</span> {fact.value}
            </p>
          ))}
          <div class="entry-personal-rating">
            {entry.rating !== null && (
              <span>
                <strong>★ {entry.rating}</strong> / 10 <small>我的评分</small>
              </span>
            )}
            {entry.status && (
              <span class="entry-status-badge">
                {entryStatuses[entry.status]}
              </span>
            )}
          </div>
          <small class="entry-credit">作品资料来自 Bangumi</small>
        </div>
      </div>
      {subject.summary && (
        <details class="entry-synopsis">
          <summary>作品简介</summary>
          <p>{subject.summary}</p>
        </details>
      )}
    </section>
  )
}
{
  category !== "paper-reading" && entry.comment && (
    <blockquote class="entry-comment">{entry.comment}</blockquote>
  )
}
{
  category === "photo" && entry.photos.length > 0 && (
    <div class="photo-gallery" aria-label="照片集">
      {entry.photos.map(photo => (
        <figure>
          <img
            src={photo.src}
            alt={photo.alt || photo.caption || "相册照片"}
            width={photo.width || undefined}
            height={photo.height || undefined}
            loading="lazy"
          />
          {photo.caption && <figcaption>{photo.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )
}
{
  category === "paper-reading" && paperSource && (
    <section class="paper-reading-source" aria-label="论文原文">
      {(entry.paper.authors || entry.paper.year || entry.paper.doi) && (
        <p class="paper-credit">
          {[entry.paper.authors, entry.paper.year].filter(Boolean).join(" · ")}
          {entry.paper.doi && (
            <>
              {" "}
              ·{" "}
              <a
                href={`https://doi.org/${encodeURI(entry.paper.doi)}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                DOI ↗
              </a>
            </>
          )}
        </p>
      )}
      {publicationText(entry.paper) && (
        <p class="paper-credit">{publicationText(entry.paper)}</p>
      )}
      <div class="paper-source-toolbar">
        <>
          <span>原文 / PDF</span>
          <div>
            <>
              <a
                href={entry.paper.sourceUrl || paperSource}
                target="_blank"
                rel="noopener noreferrer"
              >
                打开原文 ↗
              </a>
              <button type="button" data-reading-wide>
                展开阅读
              </button>
            </>
          </div>
        </>
      </div>
      {entry.paper.pdfUrl ? (
        <div
          data-paper-pdf={paperSource}
          data-paper-annotations={JSON.stringify(entry.paper.annotations)}
        >
          <PdfReader />
          <noscript>
            <a href={paperSource}>打开 PDF</a>
          </noscript>
        </div>
      ) : (
        <iframe
          src={paperSource}
          title="论文原文预览"
          loading="lazy"
          referrerpolicy="no-referrer"
        />
      )}
      <p class="paper-preview-hint">
        阅读作者的批注；作者可在写作台继续标记与编辑。
      </p>
    </section>
  )
}
<script>
  import type { PdfReader } from "@/studio/pdf-reader";
  const readers = new Map<HTMLElement, PdfReader>();
  function setupReading() {
    document
      .querySelectorAll<HTMLElement>("[data-paper-pdf]")
      .forEach(container => {
        if (container.dataset.ready) return;
        container.dataset.ready = "true";
        void import("@/studio/pdf-reader")
          .then(({ PdfReader }) => {
            if (!container.isConnected) return;
            readers.set(
              container,
              new PdfReader(container.querySelector("[data-pdf-reader]")!, {
                url: container.dataset.paperPdf!,
                annotations: JSON.parse(
                  container.dataset.paperAnnotations || "[]"
                ),
              })
            );
          })
          .catch(() => {
            container.textContent = "阅读器暂时无法加载，请刷新或打开原文。";
          });
      });
    document
      .querySelectorAll<HTMLButtonElement>("[data-reading-wide]")
      .forEach(button => {
        if (button.dataset.ready) return;
        button.dataset.ready = "true";
        button.addEventListener("click", () => {
          const expanded = button
            .closest(".article-main")
            ?.classList.toggle("reading-expanded");
          button.textContent = expanded ? "还原排版" : "展开阅读";
          button.setAttribute("aria-pressed", String(Boolean(expanded)));
        });
      });
  }
  setupReading();
  document.addEventListener("astro:page-load", setupReading);
  document.addEventListener("astro:before-swap", () => {
    readers.forEach(reader => reader.destroy());
    readers.clear();
  });
</script>
