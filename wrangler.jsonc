{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lyf0422-github-io",
  "main": "./workers/site.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/bangumi/*"],
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
