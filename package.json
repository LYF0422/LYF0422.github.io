{
  "name": "astro-paper-v6",
  "type": "module",
  "version": "6.1.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-pdf.mjs && astro dev",
    "build": "node scripts/prepare-pdf.mjs && astro check && astro build && pagefind --site dist --glob '**/[!.]*.html' && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:studio": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/google-sans-code": "^5.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "astro": "^7.0.3",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.17",
    "lodash.kebabcase": "^4.1.1",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "rehype-callouts": "^2.2.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.26.0",
